---
import PageLayout from '@/layouts/PageLayout.astro';
import PageHeading from '@/components/ui/PageHeading';
import Navbar from '@/components/ui/Navbar';
import Footer from '@/components/ui/Footer';
import PublicationList from '@/components/publications/PublicationList';
import { getCollection } from 'astro:content';

const allPubs = (await getCollection('publications')).filter(pub => !pub.data.draft);
const mappedPubs = allPubs.map(pub => {
  return {
    id: pub.slug,
    title: { zh: pub.data.title, en: pub.data.titleEn || pub.data.title },
    authors: pub.data.authors.map(a => ({ name: a, isMe: a.includes('Zining Wang') || a.includes('王子宁') })),
    venue: { zh: pub.data.venue || '', en: pub.data.venueEn || pub.data.venue || '' },
    year: pub.data.year || (pub.data.pubDate ? new Date(pub.data.pubDate).getFullYear() : new Date().getFullYear()),
    doi: pub.data.doi,
    arxiv: pub.data.arxiv,
    pdf: pub.data.pdf,
    code: pub.data.code,
    tags: pub.data.tags || [],
    status: pub.data.status,

  }
}).sort((a, b) => {
  if (a.id === 'phaseflow') return -1;
  if (b.id === 'phaseflow') return 1;
  if (a.id === 'eva') return -1;
  if (b.id === 'eva') return 1;
  return b.year - a.year;
});
---

<PageLayout title="Publications | Zining Wang">
  <Navbar client:load />
  <main class="editorial-page">
    <PageHeading client:load label="PAPERS & PREPRINTS" title={{ zh: '论文与预印本', en: 'Publications' }} description={{ zh: '论文、预印本及其代码与项目材料，随研究进展更新。', en: 'Papers, preprints, code, and accompanying research materials.' }} />
    <PublicationList client:load pubs={mappedPubs} />
  </main>
  <Footer client:load />
</PageLayout>
