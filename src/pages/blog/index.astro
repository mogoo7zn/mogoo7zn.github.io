---
import PageLayout from '@/layouts/PageLayout.astro';
import PageHeading from '@/components/ui/PageHeading';
import Navbar from '@/components/ui/Navbar';
import Footer from '@/components/ui/Footer';
import PostList from '@/components/blog/PostList';
import { getCollection } from 'astro:content';
import { blogSeries } from '@/data/blogSeries';

const allPosts = await getCollection('blog');
const activePosts = allPosts.filter((post) => !post.data.draft);

// Filter out series posts to replace them with a single Album entry
const SERIES_ENTRIES = blogSeries.map(series => ({
  series: series.id,
  slug: series.id,
  title: series.title.zh,
  titleEn: series.title.en,
  description: (n: number) => `${series.description.zh} 共 ${n} 篇。`,
  descriptionEn: (n: number) => `${series.description.en} ${n} posts.`,
  tags: series.tags,
}));

const seriesSlugs = SERIES_ENTRIES.map(s => s.series);
const normalPosts = activePosts.filter((post) => !post.data.series || !seriesSlugs.includes(post.data.series));

const finalPosts = [...normalPosts];

for (const entry of SERIES_ENTRIES) {
  const seriesPosts = activePosts.filter((post) => post.data.series === entry.series);
  if (seriesPosts.length > 0) {
    const latestDate = new Date(Math.max(...seriesPosts.map(p => p.data.pubDate.valueOf())));
    finalPosts.push({
      slug: entry.slug,
      data: {
        title: entry.title,
        titleEn: entry.titleEn,
        description: entry.description(seriesPosts.length),
        descriptionEn: entry.descriptionEn(seriesPosts.length),
        pubDate: latestDate,
        tags: entry.tags,
        isAlbum: true,
        folderCount: seriesPosts.length
      }
    } as any);
  }
}

finalPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<PageLayout title="Blog | Zining Wang">
  <Navbar client:load />
  <main class="editorial-page">
    <PageHeading client:load label="FIELD NOTES & READING" title={{ zh: '研究手记', en: 'Writing' }} description={{ zh: '论文阅读、工程实践与方法记录，以系列组织持续积累的知识。', en: 'Paper readings, engineering practice, and methods, organized into ongoing series.' }} />
    <PostList client:load posts={finalPosts.map(p => ({ slug: p.slug, data: p.data }))} />
  </main>
  <Footer client:load />
</PageLayout>
