---
import PageLayout from '@/layouts/PageLayout.astro';
import Navbar from '@/components/ui/Navbar';
import ResearchHome from '@/components/sections/ResearchHome';
import Footer from '@/components/ui/Footer';
import ScrollProgress from '@/components/ui/ScrollProgress';
import { getCollection } from 'astro:content';
import '@/styles/research-home.css';
const papers = (await getCollection('publications'))
  .filter(paper => !paper.data.draft)
  .sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0) || (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0))
  .map(paper => ({ slug: paper.slug, ...paper.data }));
---
<PageLayout>
  <Navbar client:load />
  <ScrollProgress client:load />
  <ResearchHome client:load papers={papers} />
  <Footer client:visible />
</PageLayout>
