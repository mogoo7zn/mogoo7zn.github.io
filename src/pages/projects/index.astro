---
import PageLayout from '@/layouts/PageLayout.astro';
import PageHeading from '@/components/ui/PageHeading';
import Navbar from '@/components/ui/Navbar';
import Footer from '@/components/ui/Footer';
import ProjectPageList from '@/components/projects/ProjectPageList';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const validBlogSlugs = posts.filter(post => !post.data.draft).map(post => post.slug);
---

<PageLayout title="Projects | Zining Wang">
  <Navbar client:load />
  <main class="editorial-page">
    <PageHeading client:load label="SELECTED SYSTEMS & RESEARCH" title={{ zh: '项目', en: 'Projects' }} description={{ zh: '研究问题、技术贡献与可复用的工程实现。', en: 'Research questions, technical contributions, and reusable engineering.' }} />
    <ProjectPageList client:load validBlogSlugs={validBlogSlugs} />
  </main>
  <Footer client:load />
</PageLayout>
